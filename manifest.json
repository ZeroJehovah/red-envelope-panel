{
  "manifest_version": 3,
  "name": "红包口令面板",
  "version": "0.9.6",
  "description": "在浏览器弹出面板或常显侧边栏提交 hb.unsnow.org 红包口令，支持古法/协议领取、批量队列与历史记录；面板与站点无关，浏览任意网站时都可使用。",
  "minimum_chrome_version": "116",
  "permissions": [
    "storage",
    "sidePanel",
    "alarms",
    "declarativeNetRequestWithHostAccess"
  ],
  "host_permissions": [
    "https://hb.unsnow.org/*"
  ],
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "hb-site-origin",
        "enabled": true,
        "path": "rules.json"
      }
    ]
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; img-src 'self' data:; connect-src 'self' https://hb.unsnow.org"
  },
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "hb.unsnow.org 红包口令面板",
    "default_popup": "popup.html"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
